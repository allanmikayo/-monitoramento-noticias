# Copie para .env na VM e preencha. NUNCA comite o .env preenchido.
#
# A senha entra na DATABASE_URL da Vercel e nos secrets do GitHub, então
# gere uma longa e aleatória -- 32 caracteres, sem símbolos que precisem de
# escape em URL:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

POSTGRES_USER=credit_admin
POSTGRES_PASSWORD=TROQUE_ISTO
POSTGRES_DB=credit_monitor

# Configuracao do Postgres a montar no conteiner:
#   postgresql.conf       -> Ampere A1, 12 GB (padrao)
#   postgresql-micro.conf -> E2.1.Micro, 1 GB (plano B, quando o A1 estiver
#                            sem capacidade em sa-saopaulo-1)
PG_CONF=postgresql.conf
